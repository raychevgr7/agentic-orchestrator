# Model provider (optional until agent execution is enabled)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=low

# Local workflow data
WORKFLOW_DATA_PATH=./data/workflows

# Optional Jira MCP server
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_MCP_PORT=3001
JIRA_MCP_URL=http://127.0.0.1:3001/mcp
# Required comma-separated scope, for example: PLATFORM,WEB
JIRA_ALLOWED_PROJECT_KEYS=

# Optional local-project MCP server
PROJECT_SOURCE_ROOT=
PROJECT_MCP_PORT=3002
PROJECT_MCP_URL=http://127.0.0.1:3002/mcp
# Comma-separated commands that the project MCP may execute, for example: npm test,mvn test
PROJECT_ALLOWED_COMMANDS=

# Local artifacts produced by agents
WORKFLOW_ARTIFACTS_PATH=./data/artifacts
# Each new or changed test is accepted only after this many consecutive successful runs.
TEST_SUCCESS_REPETITIONS=3
# Must contain {test}; example: npx playwright test {test}
PROJECT_TEST_COMMAND_TEMPLATE=

# Optional Jenkins MCP server
JENKINS_BASE_URL=
JENKINS_DEFAULT_JOB_PATH=
JENKINS_USERNAME=
JENKINS_API_TOKEN=
JENKINS_MCP_PORT=3003
