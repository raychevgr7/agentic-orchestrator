# Model provider (optional until agent execution is enabled)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Invalid token-budget values fall back to the safe defaults below.
ANALYSIS_MAX_OUTPUT_TOKENS=10000
TEST_PLAN_MAX_OUTPUT_TOKENS=2000
AUTOMATION_DISCOVERY_MAX_OUTPUT_TOKENS=2200
ENGINEER_PLAN_MAX_OUTPUT_TOKENS=1200
ENGINEER_DRAFT_MAX_OUTPUT_TOKENS=2000
CODE_REVIEW_MAX_OUTPUT_TOKENS=1200
PULL_REQUEST_MAX_OUTPUT_TOKENS=1000
CI_ANALYSIS_MAX_OUTPUT_TOKENS=1000
CHAT_MAX_OUTPUT_TOKENS=600

# Local workflow data
WORKFLOW_DATA_PATH=./data/workflows

# Optional Jira MCP server
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_MCP_PORT=3001
JIRA_MCP_URL=http://127.0.0.1:3001/mcp
# Required comma-separated scope, for example: PLATFORM,WEB
JIRA_ALLOWED_PROJECT_KEYS=

# Optional local-project MCP server
PROJECT_SOURCE_ROOT=
PROJECT_BASE_BRANCH=master
PROJECT_MCP_PORT=3002
PROJECT_MCP_URL=http://127.0.0.1:3002/mcp
# Comma-separated commands that the project MCP may execute, for example: npm test,mvn test
PROJECT_ALLOWED_COMMANDS=

# Local artifacts produced by agents
WORKFLOW_ARTIFACTS_PATH=./data/artifacts
# Targeted test validation uses: npx playwright test {test}, three consecutive successful runs.

# Optional read-only Jenkins CI analysis adapter
JENKINS_BASE_URL=
# Repository-relative Jenkins job path, for example: job/ui/job/main
JENKINS_DEFAULT_JOB_PATH=
# Required MCP scope. Comma-separated relative Jenkins job paths, for example: job/ui/job/main
JENKINS_ALLOWED_JOB_PATHS=
# Use a least-privilege Jenkins account and API token with read access only.
JENKINS_USERNAME=
JENKINS_API_TOKEN=
JENKINS_MCP_PORT=3003
